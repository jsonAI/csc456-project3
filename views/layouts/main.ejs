<!DOCTYPE html>
<html>
<head>
  <title>Project Manager</title>

  <style>
    body {
      font-family: Arial;
      margin: 20px;
      background: #f5f5f5;
    }

    nav {
      background: #222;
      padding: 12px;
      color: white;
    }

    nav a {
      color: white;
      margin-right: 15px;
      text-decoration: none;
      font-weight: bold;
    }

    nav a:visited {
      color: white;
    }

    nav a:hover {
      text-decoration: underline;
    }

    .container {
      background: white;
      padding: 20px;
      margin-top: 20px;
      border-radius: 8px;
    }

    /* 🔥 NORMAL LINKS */
    a {
      color: #007bff;
      text-decoration: none;
    }

    a:visited {
      color: #007bff;
    }

    a:hover {
      text-decoration: underline;
    }

    /* 🔥 BUTTON STYLE LINKS */
    .btn {
      display: inline-block;
      padding: 6px 12px;
      margin-top: 8px;
      background: #007bff;
      color: white !important;
      border-radius: 5px;
      text-decoration: none;
      font-size: 14px;
    }

    .btn:hover {
      background: #0056b3;
    }

    .btn-danger {
      background: #dc3545;
    }

    .btn-danger:hover {
      background: #a71d2a;
    }

    /* FORM FIX */
    input[type="text"], input[type="password"], select {
  padding: 6px;
  margin: 5px 0 12px 0;
  width: 300px;
  max-width: 100%;
}

/* Reset checkbox */
input[type="checkbox"] {
  width: auto;
  margin-right: 6px;
}

    label {
      display: block;
      margin-top: 10px;
      font-weight: bold;
    }

    ul {
      list-style: none;
      padding: 0;
    }

    li {
      padding: 12px;
      border-bottom: 1px solid #ddd;
    }
  </style>
</head>

<body>

  <% if (user) { %>
    <nav>
      <a href="/dashboard">Dashboard</a>
      <a href="/projects">Projects</a>
      <a href="/tasks">Tasks</a>

      | <strong><%= user.name %></strong> (<%= user.role %>)
      | <a href="/logout">Logout</a>
    </nav>
  <% } %>

  <div class="container">
    <%- body %>
  </div>

</body>
</html>