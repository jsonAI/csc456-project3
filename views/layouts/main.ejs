<!DOCTYPE html>
<html>
<head>
  <title>Project Manager</title>
  <style>
    body {
      font-family: Arial;
      margin: 20px;
      background: #f5f5f5;
    }

    nav {
      background: #222;
      padding: 10px;
      color: white;
    }

    nav a {
      color: white;
      margin-right: 15px;
      text-decoration: none;
    }

    nav a:hover {
      text-decoration: underline;
    }

    .container {
      background: white;
      padding: 20px;
      margin-top: 20px;
      border-radius: 8px;
    }

    button {
      padding: 6px 12px;
      margin-top: 10px;
      cursor: pointer;
    }

    input, select {
      padding: 5px;
      margin: 5px 0;
      width: 100%;
    }

    ul {
      list-style: none;
      padding: 0;
    }

    li {
      padding: 10px;
      border-bottom: 1px solid #ddd;
    }
  </style>
</head>
<body>

  <% if (user) { %>
    <nav>
      <a href="/dashboard">Dashboard</a>
      <a href="/projects">Projects</a>
      <a href="/tasks">Tasks</a>
  
      | <strong><%= user.name %></strong> (<%= user.role %>)
      | <a href="/logout">Logout</a>
    </nav>
  <% } %>

  <div class="container">
    <%- body %>
  </div>

</body>
</html>