<h2>Tasks</h2>

<% if (user && user.role === "admin") { %>
  <a href="/projects/create" class="btn">Create Project</a>
<% } %>

<ul>
  <% if (tasks.length === 0) { %>
    <p>No tasks yet.</p>
  <% } %>

  <% tasks.forEach(task => { %>
    <li>
      <strong><%= task.title %></strong>
      <br>
      <small>Project: <%= task.project?.title %></small>
      <br>
      <small>Assigned: <%= task.assignedTo?.name %></small>
      <br>

      <% if (user && user.role === "admin") { %>
        <a href="/projects/edit/<%= project._id %>" class="btn">Edit</a>
        <a href="/projects/delete/<%= project._id %>" class="btn btn-danger">Delete</a>
      <% } %>
    </li>
  <% }) %>
</ul>