<h2>Tasks</h2>

<% if (user && user.role === "admin") { %>
  <a href="/tasks/create" class="btn">Create Task</a>
<% } %>

<ul>
  <% if (tasks.length === 0) { %>
    <p>No tasks yet.</p>
  <% } %>

  <% tasks.forEach(task => { %>
    <li>
      <strong><%= task.title %></strong>
      <br>
      <small>Project: <%= task.project?.title %></small>
      <br>
      <small>Assigned: <%= task.assignedTo?.name %></small>

      <% if (user && user.role === "admin") { %>
        <div style="margin-top: 10px;">
          <a href="/tasks/edit/<%= task._id %>" class="btn">Edit</a>

          <form action="/tasks/delete/<%= task._id %>" method="POST" style="display:inline;">
            <button 
              type="submit"
              class="btn btn-danger"
              onclick="return confirm('Delete this task?')"
            >
              Delete
            </button>
          </form>
        </div>
      <% } %>
    </li>
  <% }) %>
</ul>