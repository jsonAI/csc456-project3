<h2>Tasks</h2>

<% if (user && user.role === "admin") { %>
  <a href="/tasks/create">Create Task</a>
<% } %>

<ul>
  <% if (tasks.length === 0) { %>
    <p>No tasks yet.</p>
  <% } %>

  <% tasks.forEach(task => { %>
    <li>
      <strong><%= task.title %></strong>
      <br>
      <small>Project: <%= task.project?.title %></small>
      <br>
      <small>Assigned: <%= task.assignedTo?.name %></small>
      <br>

      <% if (user && user.role === "admin") { %>
        <a href="/tasks/edit/<%= task._id %>">Edit</a> |
        <a href="/tasks/delete/<%= task._id %>">Delete</a>
      <% } %>
    </li>
  <% }) %>
</ul>