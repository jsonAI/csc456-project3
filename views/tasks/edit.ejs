<h2>Edit Task</h2>

<% if (!task) { %>
  <p>Task not found.</p>
  <a href="/tasks" class="btn">Back</a>
<% } else { %>

<form method="POST" action="/tasks/edit/<%= task._id %>">

  <label>Task Title</label>
  <input name="title" value="<%= task.title %>" required />

  <h4>Select Project</h4>

  <% if (projects.length === 0) { %>
    <p>No projects available.</p>
  <% } %>

  <select name="project" required>
    <% projects.forEach(p => { %>
      <option value="<%= p._id %>" 
        <%= task.project && task.project.toString() === p._id.toString() ? "selected" : "" %>>
        <%= p.title %>
      </option>
    <% }) %>
  </select>

  <h4>Assign User</h4>

  <select name="assignedTo">
    <option value="">-- Optional --</option>
    <% users.forEach(u => { %>
      <option value="<%= u._id %>" 
        <%= task.assignedTo && task.assignedTo.toString() === u._id.toString() ? "selected" : "" %>>
        <%= u.name %> (<%= u.role %>)
      </option>
    <% }) %>
  </select>

  <br>

  <button type="submit" class="btn">Update</button>
</form>

<% } %>