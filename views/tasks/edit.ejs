<h2>Edit Task</h2>

<form method="POST" action="/tasks/edit/<%= task._id %>">

  <div>
    <input name="title" value="<%= task.title %>" required />
  </div>

  <h4>Select Project</h4>
  <div>
    <select name="project">
      <% projects.forEach(p => { %>
        <option value="<%= p._id %>" 
          <%= task.project.toString() === p._id.toString() ? "selected" : "" %>>
          <%= p.title %>
        </option>
      <% }) %>
    </select>
  </div>

  <h4>Assign User</h4>
  <div>
    <select name="assignedTo">
      <% users.forEach(u => { %>
        <option value="<%= u._id %>" 
          <%= task.assignedTo?.toString() === u._id.toString() ? "selected" : "" %>>
          <%= u.name %>
        </option>
      <% }) %>
    </select>
  </div>

  <br>

  <button type="submit">Update</button>
</form>