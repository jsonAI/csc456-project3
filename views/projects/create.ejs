<h2>Create Project</h2>

<form method="POST" action="/projects/create" style="max-width: 400px;">

  <label>Title</label>
  <input name="title" placeholder="Enter project title" required />

  <label>Description</label>
  <input name="description" placeholder="Enter description (optional)" />

  <h4>Assign Users</h4>

  <% if (users.length === 0) { %>
    <p>No users available.</p>
  <% } %>

  <div style="margin-top: 10px;">
    <% users.forEach(u => { %>
      <label style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
        <input type="checkbox" name="users" value="<%= u._id %>" />
        <span><%= u.name %> (<%= u.role %>)</span>
      </label>
    <% }) %>
  </div>

  <br>

  <button type="submit" class="btn">Create</button>
</form>