<h2>Edit Project</h2>

<% if (!project) { %>
  <p>Project not found.</p>
  <a href="/projects" class="btn">Back</a>
<% } else { %>

<form method="POST" action="/projects/edit/<%= project._id %>" style="max-width: 400px;">

  <label>Title</label>
  <input name="title" value="<%= project.title %>" required />

  <label>Description</label>
  <input name="description" value="<%= project.description %>" />

  <h4>Assign Users</h4>

  <% if (users.length === 0) { %>
    <p>No users available.</p>
  <% } %>

  <div style="margin-top: 10px;">
    <% users.forEach(u => { %>
      <label style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
        <input 
          type="checkbox" 
          name="users" 
          value="<%= u._id %>"
          <%= project.users.some(id => id.toString() === u._id.toString()) ? "checked" : "" %>
        />
        <span><%= u.name %> (<%= u.role %>)</span>
      </label>
    <% }) %>
  </div>

  <br>

  <button type="submit" class="btn">Update</button>
</form>

<% } %>